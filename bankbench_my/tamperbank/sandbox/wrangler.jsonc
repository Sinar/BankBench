{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bankbench-tamper-sandbox",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      { "name": "SESSION", "class_name": "TamperSessionDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TamperSessionDO"] }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}